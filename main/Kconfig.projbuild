menu "Agent Buddy Configuration"

    menu "WiFi"
        config AGENT_BUDDY_WIFI_SSID
            string "WiFi SSID"
            default "your_ssid"
            help
                SSID of the WiFi network to connect to.

        config AGENT_BUDDY_WIFI_PASSWORD
            string "WiFi Password"
            default "your_password"
            help
                Password for the WiFi network.
    endmenu

    menu "Bluetooth"
        config AGENT_BUDDY_BT_DEVICE_NAME
            string "Bluetooth Device Name"
            default "AgentBuddy"
            help
                Name advertised over Bluetooth Classic and BLE.
    endmenu

    menu "Display"
        config AGENT_BUDDY_LCD_PCLK_MHZ
            int "LCD pixel clock (MHz)"
            default 18
            range 8 21
            help
                RGB panel pixel clock in MHz.
    endmenu

endmenu
