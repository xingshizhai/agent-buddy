# Alibaba Bailian (DashScope) — ASR + TTS
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek — LLM
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8765

# TTS voice (cosyvoice-v2 voices: longxiaochun_v2, longyue_v2, longhua_v2, ...)
TTS_VOICE=longxiaochun_v2

# LLM provider: deepseek (extensible: add more in providers/llm.py)
LLM_PROVIDER=deepseek

# System prompt
SYSTEM_PROMPT=你是一个智能助手，名叫小明。请用简短、自然的口语化中文回答。
